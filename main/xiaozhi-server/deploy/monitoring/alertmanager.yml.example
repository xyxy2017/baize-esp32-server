global:
  resolve_timeout: 5m

route:
  receiver: baize-local
  group_by: [alertname, severity]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  # Safe default: Alertmanager groups and retains alerts locally. Add an HTTPS
  # webhook/email receiver owned by the operations team before public release.
  - name: baize-local

  # Example external receiver (do not enable with a placeholder URL):
  # - name: baize-webhook
  #   webhook_configs:
  #     - url: https://alerts.example.com/baize
  #       send_resolved: true
